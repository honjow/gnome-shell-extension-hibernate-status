msgid "Hibernate"
msgstr "休眠"

#: extension.js:246
msgid "Do you really want to hibernate the system?"
msgstr "是否要将系统休眠？"

#: extension.js:250 extension.js:283 extension.js:316 extension.js:356
#: extension.js:403
msgid "Cancel"
msgstr "取消"

#: extension.js:278 extension.js:288 extension.js:448
msgid "Hybrid Sleep"
msgstr "混合睡眠"

#: extension.js:279
msgid "Do you really want to hybrid sleep the system?"
msgstr "是否要将系统切换到混合睡眠模式？"

